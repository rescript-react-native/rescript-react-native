{
  "name": "rescript-react-native",
  "namespace": "react-native",
  "jsx": {
    "version": 4
  },
  "package-specs": {
    "module": "esmodule",
    "in-source": true
  },
  "suffix": ".res.js",
  "sources": [
    {
      "dir": "src",
      "subdirs": true
    }
  ],
  "compiler-flags": [
    "-bs-no-version-header"
  ],
  "warnings": {
    "error": true
  },
  "dependencies": [
    "@rescript/react"
  ]
}